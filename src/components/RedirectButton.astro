---
interface Props {
  href: string;

}
const { href } = Astro.props;
---

<a 
    class="box-main"
    target="_blank"
    rel="noopener noreferrer"
    href={href}>
    <slot />    
</a>

<style>
.box-main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 60px 30px;
    border: 2px solid #4db8ff;
    border-radius: 8px;

    color: white;
    text-decoration: none;
    background: transparent;

    overflow: hidden;
    z-index: 1;

    transition: color 0.4s ease;
}

/* Fondo animado */
.box-main::before {
    content: "";
    position: absolute;
    inset: 0;

    background: rgba(255, 255, 255, 0.15);

    transform: scaleX(0);
    transform-origin: left;

    transition: transform 0.4s ease;

    z-index: -1;
}

/* Animación al pasar el cursor */
.box-main:hover::before {
    transform: scaleX(1);
}
</style>