---
const { title, description, image, url } = Astro.props;
---

<a href={url}>
<div class="card">
    <img src={image} alt={title} />
    <h1>{title}</h1>
    <p>{description}</p>
</div>
</a>

<style>
    @font-face {
      font-family: "MiFuente";
      src: url("../assets/fonts/pixelFontP2.woff2") format("woff2");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    .card {
        width: 300px;
        padding: 20px;

        background: black;
        border-radius: 12px;
        border: 2px solid rgba(255, 255, 0, 0.301);
        box-shadow: 0 4px 10px rgba(255, 255, 255, 0.15);

        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .card:hover {
        transform: translateY(-12px) scale(1.02);

        box-shadow: 0 20px 35px rgba(255, 255, 255, 0.3);
    }

    .card h1 {
        font-family: "MiFuente", sans-serif;
        margin-top: 0;
    }

    .card p {
        font-family: "MiFuente", sans-serif;
        color: #555;
    }

    .card button {
        padding: 10px 16px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }
    a {
        text-decoration: none;
        color: inherit;
    }
</style>
