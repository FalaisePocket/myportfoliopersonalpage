--- 
const links = [ 
    { name: "Inicio", href: "/" },
    { name: "Hoja de vida", href: "/MiCV" },
    { name: "Proyectos", href: "/proyectos" },
    { name: "Blog", href: "/blog" }, 
    { name: "Contacto", href: "/contacto" }, 
    
]; 
--- 
<nav class="navbar"> 
    <div class="navbar-container"> 
        <a href="/" class="logo">Mi Portafolio</a> 
        <div class="nav-links"> 
            {links.map((link) => ( <a href={link.href}>{link.name}</a> ))} 
        </div> 
    </div> 
</nav> 
<style>
@font-face {
      font-family: "Montserrat";
      src: url("../assets/fonts/Montserrat-VariableFont_wght.ttf") 
      format("truetype");
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

a{
    font-family: "Montserrat", sans-serif;
    color: #5db5fd;
    font-weight: 300;
    font-size: 1.5rem;
}
.navbar { 
    width: 100%; 
    box-sizing: border-box;
    padding: 1.2rem 2rem; 
    background: #000; 
    border-bottom: 1px solid #222; 
} 
.navbar-container { 
    max-width: 1200px; 
    margin: 0 auto; 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
} 
.logo { 
    color: white; 
    font-size: 1.2rem; 
    font-weight: 700; 
    text-decoration: none; 
} 
.nav-links { 
    display: flex; gap: 2rem; 
} 
.nav-links a { 
    color: #aaa; text-decoration: none; font-size: 1rem; transition: color 0.2s ease; 
} 
.nav-links a:hover { 
    color: white; 
} 
@media (max-width: 600px) { 
    .navbar-container { 
        flex-direction: column; 
        gap: 1rem; 
    } 
    .nav-links { 
        gap: 1rem; 
    } 
} 
</style>