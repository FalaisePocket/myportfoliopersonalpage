---
import Layout from '../layouts/Layout.astro';
import Carousel from '../layouts/Carousel.astro';

//Frameworks logo imports
import astroLogo from '../assets/cv/Node.js.svg';
import reactLogo from '../assets/cv/Node.js.svg';
import viteLogo from '../assets/cv/Node.js.svg';
import nextLogo from '../assets/cv/Node.js.svg';
import bootstrapLogo from '../assets/cv/Node.js.svg';
import djangoLogo from '../assets/cv/Node.js.svg';
import flaskLogo from '../assets/cv/Node.js.svg';
import DRFLogo from '../assets/cv/Node.js.svg';
import expressLogo from '../assets/cv/Node.js.svg';
import androidLogo from '../assets/cv/Node.js.svg';
import nodejsLogo from '../assets/cv/Node.js.svg';
//Programming languages logo imports
import javascriptLogo from '../assets/cv/Node.js.svg';
import pythonLogo from '../assets/cv/Node.js.svg';
import typescriptLogo from '../assets/cv/Node.js.svg';
import csharpLogo from '../assets/cv/Node.js.svg';
import cLogo from '../assets/cv/Node.js.svg';
//Database logo imports
import postgresqlLogo from '../assets/cv/Node.js.svg';
//importing tools logo imports
import dockerLogo from '../assets/cv/Node.js.svg';
import postmanLogo from '../assets/cv/Node.js.svg';

import RedirectButton from '../components/RedirectButton.astro';
---

<Layout>
  <div class="main-section">
  <div class="title">
    <h1>VICTOR DANIEL VALENCIA ÑAÑEZ</h1>
    <h1>JUNIOR SOFTWARE DEVELOPER</h1>
  </div>
  
  <div class="section-left">
    
    <div class="text-container">
      <h2>Perfil Profesional</h2>
      <p> 
        Ingeniero de Sistemas graduado de la Universidad del Valle, con conocimientos en desarrollo de software, programación web y diseño de soluciones tecnológicas. 
        Manejo tecnologías como Python, JavaScript, TypeScript, React, Django REST Framework y PostgreSQL, con experiencia práctica en el desarrollo de aplicaciones web, 
        construcción de API REST y gestión de bases de datos mediante proyectos académicos y personales.
      </p>
      <p>
        Me caracterizo por mi pensamiento analítico, capacidad de resolución de problemas, aprendizaje rápido y adaptabilidad. Soy una persona proactiva, 
        organizada y orientada a la mejora continua, con interés en participar en proyectos de desarrollo de software, especialmente en áreas de backend y 
        desarrollo full-stack.  
      </p>
    </div>

    
  </div>


  <div>
    <h2>Proyectos Destacados</h2>
    <div >
      
      <RedirectButton href="/proyectos">
        <p>Haz click aquí para ver todos los proyectos en los que he contrubuido y he desarrollado</p>
      </RedirectButton>
    </div>
  </div>


  <div class="section-left">
    
    <div class="text-container">
    <h2>Educación y certificaciones</h2>
    <h3>Ingeniería de Sistemas</h3>
    <p>En</p>
    <p>Universidad del Valle</p>
    <p>Cali, Colombia</p>
    <p>2020 - 2026</p>

    <h3>Google Cloud Computing Foundationss Certificate</h3>
    <p>En</p>
    <p>Google Skills</p>
    <p>2024</p>
    </div>
  </div>

  <div class="section-left">
    <div>
      <h2>Habilidades blandas</h2>
      <p>Trabajo en equipo</p>
      <p>Comunicación efectiva</p>
      <p>Resolución de problemas</p>
      <p>Adaptabilidad</p>
      <p>Gestión del tiempo</p>
      <p></p>
      <p></p>
      <h2>Idiomas</h2>
      <h3>Español</h3>
      <p>Nativo</p>
      <h3>Inglés</h3>
      <p>B2+ (Intermedio)</p>
    </div>
    
  </div>


  



  
    <h2>Tecnologías</h2>
    <div class="section-left">

      
      <Carousel radius={200} size={500} itemSize={60} duration={8}>
        
      </Carousel>
      
    <div class="text-container">
      <h3>Frameworks</h3>
      <p>React</p>
      <p>Vite.js</p>
      <p>Astro</p>
      <p>Next.js</p>
      <p>Bootstrap</p>
      <p>Node.js</p>
      <p>Django</p>
      <p>Django REST Framework</p>
      <p>Express.js</p>
      <p>Android SDK</p>
      <p>Flask</p>
      </div>
    </div>


    <div class="section-left">
      
      <div class="text-container">
        <h3>Lenguajes de programación</h3>
        <p>JavaScript</p>
        <p>Python</p>
        <p>TypeScript</p>
        <p>C#</p>
        <p>C/C++</p>
      </div>
      <Carousel radius={200} size={500} itemSize={60} duration={8}>
        
      </Carousel>
    </div>


    <div class="section-right">
      
      <div class="text-container">
        <h3>Bases de datos</h3>
        <p>PostgreSQL</p>
      </div>
    </div>
    
    <div class="section-left">
      <div class="text-container">
        <h3>Herramientas</h3>
        <p>Docker</p>
        <p>Postman</p>
        <p>Power BI</p>
        <p>Git</p>
        <p>GitHub</p>
      </div>
      <Carousel radius={200} size={500} itemSize={60} duration={8}>
        
        
      </Carousel>
    </div>
    
    <div class="section-right">
      <Carousel radius={200} size={500} itemSize={60} duration={8}>
        
      </Carousel>
      <div class="text-container">
        <h3>Librerías</h3>
        <p>Pandas</p>
        <p>Tkinter</p>
        <p>Numpy</p>
        <p>Matplotlib</p>

      </div>
    </div>

    
  
  
  
</div>  
</Layout>


<style>
  @font-face {
      font-family: "Montserrat";
      src: url("../assets/fonts/Montserrat-VariableFont_wght.ttf") 
      format("truetype");
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

  h1,h2,h3{
    font-family:  "Montserrat", sans-serif;
    color: #5db5fd;
    font-weight: 300;
  }
  h1{
    font-size: 2.5rem;
  }
  h2{
    font-size: 2rem;
  }
  h3{
    font-size: 1.5rem;
  }

  p{
    font-family: Calibri, sans-serif;
    font-size: 1.75rem;

  }

  .title {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .text-container{
    flex-direction: column;
  }
  .section-left {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    gap: 10%;
    padding: 0;
  }
  .section-right {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 10%;
    padding: 0;
  }
  p {
    text-align: justify;
  }
  .main-section {
    padding: 2rem 20rem 2rem 20rem;
  }
</style>