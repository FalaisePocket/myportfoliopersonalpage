---
import Layout from '../layouts/Layout.astro';

const projects = [
  { number: '01', title: 'Nómada Studio', type: 'Identidad visual · Web', color: 'coral', year: '2025' },
  { number: '02', title: 'Ruta Clara', type: 'Producto digital · UX/UI', color: 'blue', year: '2024' },
  { number: '03', title: 'Origen Café', type: 'E-commerce · Dirección de arte', color: 'yellow', year: '2024' },
];
---

<Layout title="Tu Nombre — Portafolio" description="Portafolio de diseño y desarrollo digital de Tu Nombre.">
  <header class="shell nav">
    <a class="brand" href="#inicio">TU<span>•</span>NOMBRE</a>
    <nav aria-label="Navegación principal">
      <a href="#trabajo">Trabajo</a>
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <a class="button button--dark nav-cta" href="mailto:hola@tucorreo.com">Hablemos <span>↗</span></a>
  </header>

  <main id="inicio">
    <section class="hero shell">
      <p class="eyebrow">Diseñador/a & desarrollador/a independiente</p>
      <h1>Diseño experiencias digitales con <em>criterio</em> y carácter.</h1>
      <div class="hero-bottom">
        <p>Ayudo a marcas y proyectos ambiciosos a verse bien, comunicar mejor y crecer con intención.</p>
        <a class="round-link" href="#trabajo" aria-label="Ver proyectos">↓</a>
      </div>
    </section>

    <section class="ticker" aria-label="Servicios">
      <div>ESTRATEGIA <i>✦</i> IDENTIDAD <i>✦</i> EXPERIENCIA DIGITAL <i>✦</i> DIRECCIÓN DE ARTE <i>✦</i></div>
    </section>

    <section id="trabajo" class="work shell">
      <div class="section-head"><p class="eyebrow">Proyectos seleccionados</p><span>2024—25</span></div>
      <div class="project-grid">
        {projects.map((project) => <article class={`project ${project.color}`}>
          <div class="project-visual"><span>{project.number}</span><div class="shape"></div></div>
          <div class="project-info"><div><h2>{project.title}</h2><p>{project.type}</p></div><span>{project.year} ↗</span></div>
        </article>)}
      </div>
    </section>

    <section id="sobre-mi" class="about shell">
      <p class="eyebrow">Una breve introducción</p>
      <div class="about-copy"><h2>Menos ruido.<br />Más <em>claridad.</em></h2><div><p>Trabajo entre la estrategia, el diseño y el código para crear marcas y productos que dejan una impresión real.</p><p>Mi enfoque combina curiosidad, sistemas sólidos y una atención casi obsesiva a los detalles.</p><a href="mailto:hola@tucorreo.com" class="text-link">Conoce mi forma de trabajar →</a></div></div>
    </section>
  </main>

  <footer id="contacto" class="footer">
    <div class="shell"><p class="eyebrow">¿Tienes un proyecto en mente?</p><a href="mailto:hola@tucorreo.com" class="footer-title">Hagamos algo<br /><em>memorable.</em> <span>↗</span></a><div class="footer-bottom"><span>© 2025 Tu Nombre</span><div><a href="#">LinkedIn</a><a href="#">Instagram</a><a href="#">Behance</a></div></div></div>
  </footer>
</Layout>

<style>
  .nav { height:92px; display:flex; justify-content:space-between; align-items:center; }
  .brand { font-weight:800; letter-spacing:-.08em; font-size:1.15rem; }.brand span { color:#a3cb2f; }
  nav { display:flex; gap:1.8rem; font-size:.84rem; font-weight:600; } nav a:hover { color:var(--forest); }
  .hero { padding-top:95px; padding-bottom:108px; }.hero h1 { max-width:960px; margin:24px 0 35px; font-size:clamp(3.25rem, 7.1vw, 6.9rem); line-height:.98; letter-spacing:-.075em; font-weight:700; }.hero em, .about em, .footer em { font-family:Georgia, serif; font-weight:400; }
  .hero-bottom { display:flex; justify-content:space-between; align-items:end; }.hero-bottom p { max-width:370px; margin:0; color:var(--muted); font-size:1rem; line-height:1.65; }.round-link { display:grid; place-items:center; width:58px; height:58px; background:var(--lime); border-radius:50%; font-size:1.6rem; }
  .ticker { overflow:hidden; white-space:nowrap; padding:17px 0; background:var(--forest); color:#e7ff9c; font-family:'DM Mono',monospace; font-size:.85rem; letter-spacing:.06em; }.ticker div { animation: shift 20s linear infinite; width:max-content; }.ticker i { color:white; margin:0 1rem; font-style:normal; }@keyframes shift { to { transform:translateX(-20%); } }
  .work { padding-top:125px; padding-bottom:145px; }.section-head, .project-info, .footer-bottom { display:flex; justify-content:space-between; }.section-head { margin-bottom:28px; border-bottom:1px solid var(--line); padding-bottom:17px; }.section-head span { font-family:'DM Mono'; font-size:.75rem; color:var(--muted); }
  .project-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }.project-visual { position:relative; overflow:hidden; height:400px; padding:20px; }.project-visual span { font-family:'DM Mono'; font-size:.75rem; }.coral .project-visual { background:#df735c; }.blue .project-visual { background:#98b8d5; }.yellow .project-visual { background:#efca52; }.shape { position:absolute; inset:23% 16%; border-radius:45% 55% 40% 60%; background:#fbf6ec; transform:rotate(-14deg); }.blue .shape { border-radius:50%; background:var(--forest); transform:none; }.yellow .shape { inset:28% 12%; background:#ea613b; border-radius:50% 50% 8% 8%; transform:rotate(30deg); }.project-info { padding:15px 0; }.project-info h2 { margin:0 0 4px; font-size:1.05rem; letter-spacing:-.04em; }.project-info p, .project-info > span { margin:0; color:var(--muted); font-family:'DM Mono'; font-size:.68rem; }.project-info > span { color:var(--ink); }
  .about { border-top:1px solid var(--line); padding-top:28px; padding-bottom:145px; }.about-copy { display:grid; grid-template-columns:1.2fr .8fr; gap:10%; margin-top:80px; }.about h2 { margin:0; font-size:clamp(3rem,5.4vw,5rem); line-height:1; letter-spacing:-.075em; }.about-copy div { color:var(--muted); line-height:1.7; }.about-copy p:first-child { margin-top:0; }.text-link { display:inline-block; margin-top:18px; color:var(--ink); border-bottom:1px solid var(--ink); font-weight:700; }
  .footer { padding:100px 0 28px; color:#f8f8ef; background:var(--ink); }.footer .eyebrow { color:#c0e459; }.footer-title { display:block; margin:20px 0 100px; font-size:clamp(3.3rem, 7vw, 6.8rem); line-height:.94; letter-spacing:-.075em; }.footer-title span { color:var(--lime); font-family:Manrope; font-size:.65em; }.footer-bottom { border-top:1px solid #405047; padding-top:20px; color:#abb8af; font-family:'DM Mono'; font-size:.68rem; }.footer-bottom div { display:flex; gap:20px; }.footer-bottom a:hover { color:white; }
  @media (max-width:720px) { .nav { height:72px; }.nav nav { display:none; }.nav-cta { font-size:.75rem; padding:.65rem .8rem; }.hero { padding-top:70px; padding-bottom:75px; }.project-grid { grid-template-columns:1fr; }.project-visual { height:330px; }.about-copy { grid-template-columns:1fr; gap:32px; margin-top:55px; }.about { padding-bottom:90px; }.footer { padding-top:70px; }.footer-title { margin-bottom:75px; }.footer-bottom { gap:20px; align-items:start; flex-direction:column; } }
</style>
