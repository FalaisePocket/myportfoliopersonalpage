---
import Navbar from "../components/Navbar.astro";
---

<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mi página</title>
</head>

<body>
    <Navbar />

    <main>
        <slot />
    </main>
</body>
</html>
<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }
h1, h2, h3, h4, h5, h6, p  {
    color: white;
  }
html, body {
    height: 100%;
    margin: 0;
  }
body {
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #000;
    background-image: radial-gradient(
      ellipse at bottom center,
      rgba(255, 255, 255, 0.35) 0%,
      rgba(255, 255, 255, 0.12) 25%,
      rgba(0, 0, 0, 0) 60%
    );
    background-repeat: no-repeat;
}
main {
  flex: 1;           /* ocupa todo el espacio que sobra debajo del navbar */
  overflow-y: auto;  /* aquí sí hay scroll */
  min-height: 0;     /* IMPORTANTE en flex, si no el overflow no funciona bien */
}
.glow {
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: white;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.4;
  }
</style>
<div class="glow"></div>